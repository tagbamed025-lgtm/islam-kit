[[[0, 2.25], "Ils l'ont couché sur le sable brûlant de La Mecque."], [[2.72, 3.81], "Une pierre énorme"], [[4.12, 4.97], "sur la poitrine."], [[5.42, 6.36], "Son maître lui disait :"], [[6.81, 8.58], "« Tu resteras ainsi jusqu'à ta mort…"], [[9.03, 10.88], "ou jusqu'à ce que tu renies Muhammad. »"], [[11.33, 12.54], "Il n'a répondu qu'un seul mot."], [[12.99, 13.59], "Il s'appelait"], [[14.36, 15.4], "Bilal ibn Rabah."], [[15.86, 17.53], "Un esclave d'Abyssinie."], [[17.98, 18.92], "Le soleil de midi,"], [[19.68, 20.3], "la chaleur,"], [[20.94, 21.57], "la soif…"], [[22.02, 23.52], "Et toujours la même réponse :"], [[23.97, 24.5], "« Ahad."], [[24.95, 25.48], "Ahad."], [[25.93, 26.49], "» Un seul."], [[26.94, 27.61], "Un seul Dieu."], [[28.06, 29.1], "Abou Bakr l'a racheté…"], [[29.84, 30.46], "et l'a libéré."], [[30.92, 32.53], "Des années plus tard,"], [[33.13, 34.5], "à Médine,"], [[34.93, 35.83], "c'est sa voix que"], [[36.48, 37.06], "le Prophète,"], [[37.47, 38.59], "paix et salut sur lui,"], [[39.04, 40.13], "a choisie pour appeler à la prière."], [[40.74, 43.28], "L'esclave torturé était devenu le premier muezzin de l'islam."]]